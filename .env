# Application
ENVIRONMENT=development
APP_NAME=Production Downtime Management System
COMPANY_NAME=Your Company
TIMEZONE=Asia/Kolkata

# Backend
SECRET_KEY=change-me-to-a-long-random-string
JWT_SECRET=change-me-to-a-different-long-random-string
JWT_EXPIRE_MINUTES=480
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Database (async SQLAlchemy URL)
DATABASE_URL=postgresql+asyncpg://pdms:pdms@localhost:5432/pdms

# Development seed credentials — NEVER use these in production
DEV_ADMIN_USERNAME=admin
DEV_ADMIN_PASSWORD=ChangeMeAdmin123!
DEV_SUPERVISOR_USERNAME=supervisor
DEV_SUPERVISOR_PASSWORD=ChangeMeSupervisor123!

# Optional: seed demo stoppage records (development/testing only)
SEED_DEMO_STOPPAGES=false

# Frontend (Vite)
VITE_API_BASE_URL=http://localhost:8000
VITE_WS_URL=ws://localhost:8000/api/ws
VITE_APP_NAME=Production Downtime Management System
VITE_COMPANY_NAME=Your Company
